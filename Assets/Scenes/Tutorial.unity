  m_text: "\uBAAC\uC2A4\uD130\uB294 \uC544\uAD70 \uD544\uB4DC\uB97C \uCE68\uB7B5\uD558\uB294
    \uC874\uC7AC\uB85C, \uB2E4\uC591\uD55C \uC885\uB958\uAC00 \uC874\uC7AC\uD558\uBA70
    \uAC00\uB85C\uB85C\uB9CC \uC774\uB3D9\uD569\uB2C8\uB2E4.\n\n\uBCF4\uC2A4\uB294
    \uC2A4\uD14C\uC774\uC9C0\uC758 \uB9C8\uC9C0\uB9C9 \uC6E8\uC774\uBE0C\uC5D0\uC11C
    \uB4F1\uC7A5\uD558\uB294 \uAC15\uB825\uD55C \uC801\uC785\uB2C8\uB2E4.\r\n\uC77C\uBC18
    \uC801\uAD70\uBCF4\uB2E4 HP\uAC00 \uB192\uACE0, \uD788\uD2B8\uBC15\uC2A4\uB294
    3\uAC1C\uC758 \uD589\uC744 \uCC28\uC9C0\uD569\uB2C8\uB2E4.\r\n\uADFC\uAC70\uB9AC
    \uACF5\uACA9\uC744 \uD558\uBA70 3\uAC1C\uC758 \uD589\uC744 \uB3D9\uC2DC\uC5D0
    \uD0C0\uACA9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r"
