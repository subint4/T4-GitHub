  m_text: "\uC804\uD22C\uB294 \uD2B9\uC815 \uC870\uAC74\uC744 \uCDA9\uC871\uD558\uBA74
    \uC2B9\uB9AC\uD558\uAC70\uB098 \uD328\uBC30\uD558\uAC8C \uB429\uB2C8\uB2E4.\r\n\r\n\uC2B9\uB9AC
    \uC870\uAC74: \uD574\uB2F9 \uB9F5\uC5D0 \uB4F1\uC7A5\uD55C \uBAA8\uB4E0 \uBAAC\uC2A4\uD130\uB97C
    \uCC98\uCE58\uD558\uBA74 \uC2B9\uB9AC\uD569\uB2C8\uB2E4.\r\n\uD328\uBC30 \uC870\uAC74:
    \uBAAC\uC2A4\uD130 \uD55C \uB9C8\uB9AC\uB77C\uB3C4 \uC544\uAD70 \uC815\uB839
    \uD544\uB4DC\uC758 \uB9C8\uC9C0\uB9C9 \uCE78\uC744 \uC9C0\uB098 \uB369\uAD74\uC5D0
    \uB3C4\uB2EC\uD558\uBA74 \uD328\uBC30\uD569\uB2C8\uB2E4"
