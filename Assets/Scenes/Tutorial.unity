  m_text: "\uB2E4\uC774\uC544: \uC0C1\uC810 \uB0B4 \uCDA9\uC804 \uC2DC\uC2A4\uD15C\uC744
    \uD1B5\uD574 \uAD6C\uB9E4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB2E4\uC774\uC544\uB97C
    \uD1B5\uD574 \uAD6C\uC785 \uAC00\uB2A5\uD55C \uD504\uB9AC\uBBF8\uC5C4 \uC544\uC774\uD15C,
    \uD2B9\uBCC4 \uAE30\uB2A5 \uD639\uC740 \uD55C\uC815 \uC774\uBCA4\uD2B8 \uCC38\uC5EC
    \uAE30\uD68C \uB4F1\uC774 \uC81C\uACF5\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uBCC4:
    \uAC8C\uC784 \uD50C\uB808\uC774\uC640 \uC774\uBCA4\uD2B8 \uCC38\uC5EC\uB97C \uD1B5\uD574
